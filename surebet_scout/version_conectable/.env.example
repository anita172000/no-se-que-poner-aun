# Copia este archivo como .env (en esta misma carpeta) y rellena lo que tengas.
# El .env no se sube a git. Nunca compartas su contenido.

# --- Cuotas (odds-api.io). Sin clave se usan datos de ejemplo. ---
ODDS_API_KEY=

# --- Betfair Exchange (API oficial). Sin esto, Betfair va simulado. ---
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=

# Pon 1 para enviar apuestas REALES a Betfair (siempre con tu confirmación).
SUREBET_LIVE=0

# --- Opcional ---
# BETFAIR_MIN_STAKE=2
# BETFAIR_LOGIN_URL=https://identitysso.betfair.es/api/login
# BETFAIR_KEEPALIVE_URL=https://identitysso.betfair.es/api/keepAlive
# BETFAIR_BETTING_URL=https://api.betfair.com/exchange/betting/json-rpc/v1
# BETFAIR_ACCOUNT_URL=https://api.betfair.com/exchange/account/json-rpc/v1
# SUREBET_PORT=8050
# SUREBET_DB=datos/surebet.db
